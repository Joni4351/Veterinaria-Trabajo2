# Alternativa a appsettings: variables de entorno de ASP.NET Core.
# El backend no carga un archivo .env automaticamente: exporte estas variables
# en la terminal o configurelas en el servicio que ejecuta la aplicacion.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5021

# Complete la conexion PostgreSQL de Supabase (host, puerto, usuario y password).
ConnectionStrings__miconexion="Host=TU_HOST_SUPABASE;Port=5432;Database=postgres;Username=TU_USUARIO;Password=;SSL Mode=Require"

# Complete con una clave propia para firmar JWT (al menos 32 caracteres).
Jwt__Key=
Jwt__Issuer=VeterinariaAPI
Jwt__Audience=VeterinariaAPI
Jwt__ExpireMinutes=60

# Clave independiente para cifrado facial: 32 bytes aleatorios en Base64.
Biometrics__EncryptionKey=
