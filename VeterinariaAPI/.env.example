# =====================================================================
# VARIABLES DE ENTORNO - BACKEND (ASP.NET Core 8 Web API)
# =====================================================================
# Entorno de ejecución: Development / Staging / Production
ASPNETCORE_ENVIRONMENT=Development

# Puerto y URLs de escucha de Kestrel
ASPNETCORE_URLS=http://localhost:5021

# Cadena de conexión a Base de Datos SQL Server / LocalDB
# Si se usan variables de entorno en .NET, se mapean con doble guión bajo (__)
ConnectionStrings__miconexion=server=.\\sqlexpress;Initial Catalog=veterinariodb;Trusted_Connection=True;TrustServerCertificate=True;

# Parámetros de Autenticación y Firma JWT
Jwt__Key=VeterinariaAPISecretKeyParaJWT2026_DebeTenerAlMenos32Caracteres!
Jwt__Issuer=VeterinariaAPI
Jwt__Audience=VeterinariaAPI

