# Copiar a .env y completar los campos privados antes de docker compose up.
# Plantilla pública: no contiene contraseñas, claves ni conexiones reales.
# Perfil local: inicia PostgreSQL, API y frontend.
COMPOSE_PROFILES=local
SANDBOX_DB_PASSWORD=
Jwt__Key=
# Base64 de 32 bytes aleatorios. Conservar para leer biometría existente.
Biometrics__EncryptionKey=
Jwt__Issuer=VeterinariaAPI
Jwt__Audience=VeterinariaAPI
Jwt__ExpireMinutes=60
FRONTEND_PORT=5173
# Solo para una base local nueva; revisar migraciones en bases existentes.
Database__MigrateOnStartup=true
Demo__Enabled=false
# Primer administrador: correo propio y contraseña privada de al menos 12 caracteres.
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=
Swagger__Enabled=false
# Vacío: utilizar PostgreSQL local. Nube: completar conexión privada y vaciar COMPOSE_PROFILES.
ConnectionStrings__miconexion=
