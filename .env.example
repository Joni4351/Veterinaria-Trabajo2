# Copy to .env, fill secrets locally, then docker compose up --build.
# local starts PostgreSQL too. For a cloud database set ConnectionStrings__miconexion
# explicitly and clear COMPOSE_PROFILES; do not enable migration on a live cloud DB blindly.
COMPOSE_PROFILES=local
SANDBOX_DB_PASSWORD=
Jwt__Key=
Biometrics__EncryptionKey=
Jwt__Issuer=VeterinariaAPI
Jwt__Audience=VeterinariaAPI
FRONTEND_PORT=5173
Database__MigrateOnStartup=true
Demo__Enabled=false
Bootstrap__AdminEmail=admin@example.invalid
# At least 12 characters; never commit the completed file.
Bootstrap__AdminPassword=
Swagger__Enabled=false
