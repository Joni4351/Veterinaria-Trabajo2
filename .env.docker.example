# Copy to .env.docker; never commit the completed private file.
# Single quotes preserve literal dollar signs in connection strings and keys.
ConnectionStrings__miconexion='Host=TU_HOST;Port=5432;Database=postgres;Username=TU_USUARIO;Password=TU_PASSWORD;SSL Mode=Require'
Jwt__Key=
Jwt__Issuer=VeterinariaAPI
Jwt__Audience=VeterinariaAPI
Jwt__ExpireMinutes=60
# Use the SAME existing Base64 key (32 bytes) to read previously enrolled faces.
Biometrics__EncryptionKey=
FRONTEND_PORT=5173
# Only for compose.sandbox.yaml; use a local test password, not Supabase credentials.
SANDBOX_DB_PASSWORD=
